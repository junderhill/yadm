# Tools for the Mac and personal Linux boxes (Homebrew on Linux).
# Installed by ~/.config/yadm/bootstrap. Never used on Chef-managed devboxes: the
# bootstrap skips installs there, so whatever Chef manages stays Chef's.
#
#   brew "x"   always from Homebrew. The shell config needs a recent version that
#              system packages often lack (e.g. Ubuntu's fzf can't do `fzf --bash`).
#   tool "x"   only installed if the command isn't already present some other way
#              (system package, official installer, Chef...). A copy that Homebrew
#              installed still counts as ours, so `brew bundle` keeps upgrading it.

def tool(formula, command = formula)
  prefix = defined?(HOMEBREW_PREFIX) ? HOMEBREW_PREFIX.to_s : ENV.fetch("HOMEBREW_PREFIX", "/opt/homebrew")
  search = ENV["HOMEBREW_PATH"] || ENV["PATH"]   # brew narrows PATH; HOMEBREW_PATH is the user's real one
  found = search.split(":").map { |d| File.join(d, command) }.find { |p| File.executable?(p) && !File.directory?(p) }
  if found.nil? || found.start_with?(prefix)
    brew formula
  else
    puts "Brewfile: skipping #{formula}, already provided by #{found}" if ENV["HOMEBREW_VERBOSE"]
  end
end

# --- what the shell config is built on ---
brew "starship"
brew "mcfly"
brew "zoxide"
brew "fzf"
brew "neovim"            # LazyVim needs a newer nvim than most distros ship
tool "fd"                # used by fzf's Ctrl-T (respects .gitignore)

# --- daily tools ---
tool "git"
tool "tmux"
tool "gh"
tool "yadm"
tool "ripgrep", "rg"
tool "jq"
tool "glow"
tool "just"
tool "uv"
tool "go"

if OS.mac?
  brew "zsh-autosuggestions"
  brew "zsh-syntax-highlighting"
  brew "gawk"            # GNU awk, same as Linux
  brew "libpq"           # psql
  brew "python@3.11"
end
